# ============================================================================
# Bridal OS — environment variables
# ============================================================================
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# IMPORTANT: variables live in TWO places.
#   1. Next.js  -> `.env.local` (the frontend + Next server). Listed below.
#   2. Convex   -> the Convex deployment env, NOT this file. Set those with:
#                  npx convex env set STRIPE_SECRET_KEY sk_test_xxx
#                  (or via the Convex dashboard > Settings > Environment Variables)
#      They are listed at the bottom for reference.
# ============================================================================


# ----------------------------------------------------------------------------
# 1) NEXT.JS  (.env.local)
# ----------------------------------------------------------------------------

# Convex deployment URL. Printed by `npx convex dev`, or found in the Convex
# dashboard. Looks like https://your-deployment-123.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Set automatically by `npx convex dev` — leave blank and let the CLI write it.
# Identifies which Convex deployment the CLI/codegen targets.
CONVEX_DEPLOYMENT=

# Clerk authentication keys. From https://dashboard.clerk.com > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME


# ----------------------------------------------------------------------------
# 2) CONVEX DEPLOYMENT ENV  (set with `npx convex env set NAME value`)
#    These are read by Convex functions (convex/*.ts), NOT by Next.js.
#    They are listed here only so you know the full set required.
# ----------------------------------------------------------------------------

# Public site URL used to build bride portal + Stripe return links.
# e.g. http://localhost:3000 in dev, https://app.yourdomain.com in prod.
SITE_URL=http://localhost:3000

# Stripe — for collecting bride payments. From https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Signing secret for the /stripe-webhook endpoint. From the Stripe dashboard
# webhook config, or `stripe listen` in local dev. Without it, the webhook
# safely rejects all calls (payments won't auto-mark as paid).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Resend — for transactional email (welcome, reminders, notifications).
# From https://resend.com/api-keys. If unset, emails are logged, not sent.
RESEND_API_KEY=re_REPLACE_ME
